{
  "title": "Bizcore ERP - Business Operations",
  "uid": "biz-ops",
  "panels": [
    {
      "title": "Payment Success vs Compensation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afm0yahm9fcw0b" },
          "expr": "(sum(rate(payment_completed_total[5m])) or on() vector(0))",
          "legendFormat": "Completed"
        },
        {
          "datasource": { "type": "prometheus", "uid": "afm0yahm9fcw0b" },
          "expr": "(sum(rate(payment_reversed_total[5m])) or on() vector(0))",
          "legendFormat": "Reversed (Failed)"
        }
      ]
    },
    {
      "title": "Payment Transaction Volume ($)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afm0yahm9fcw0b" },
          "expr": "(sum(rate(payment_amount_sum[5m])) or on() vector(0))",
          "legendFormat": "Total Amount"
        }
      ]
    },
    {
      "title": "Audit Tamper Detection",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "afm0yahm9fcw0b" },
          "expr": "(sum(audit_verification_failures_total) or on() vector(0))",
          "legendFormat": "Integrity Failures"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    }
  ],
  "refresh": "10s"
}
