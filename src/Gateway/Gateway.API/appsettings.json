{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "BizcoreERPSecretKeyMustBeVeryLongAndSecure!!!",
    "Issuer": "bizcore-identity",
    "Audience": "bizcore-erp"
  },
  "ReverseProxy": {
    "Routes": {
      "invoice-route": {
        "ClusterId": "invoice-cluster",
        "Match": { "Path": "/api/v1/invoice/{**catch-all}" }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/v1/payment/{**catch-all}" }
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "Match": { "Path": "/api/v1/report/{**catch-all}" }
      },
      "orchestration-route": {
        "ClusterId": "orchestration-cluster",
        "Match": { "Path": "/api/v1/orchestration/{**catch-all}" }
      },
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" },
        "AuthorizationPolicy": "Anonymous"
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "identity-roles-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/roles/{**catch-all}" }
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": { "Path": "/api/v1/audit/{**catch-all}" }
      }
    },
    "Clusters": {
      "invoice-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5001" } } },
      "payment-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5002" } } },
      "report-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5003" } } },
      "orchestration-cluster": { "Destinations": { "d1": { "Address": "http://localhost:5004" } } },
      "identity-cluster":      { "Destinations": { "d1": { "Address": "http://localhost:5005" } } },
      "audit-cluster":         { "Destinations": { "d1": { "Address": "http://localhost:5006" } } }
    }
  }
}
