{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "BizcoreERPSecretKeyMustBeVeryLongAndSecure!!!",
    "Issuer": "bizcore-admin",
    "Audience": "bizcore-erp"
  },
  "ReverseProxy": {
    "Routes": {
      "invoice-route": {
        "ClusterId": "invoice-cluster",
        "Match": {
          "Path": "/api/v1/invoice/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payment/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "payment-hub-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/hubs/payment/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "Match": {
          "Path": "/api/v1/report/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "orchestration-route": {
        "ClusterId": "orchestration-cluster",
        "Match": {
          "Path": "/api/v1/orchestration/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "identity-auth-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "Public"
      },
      "identity-users-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "identity-roles-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/roles/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "admin-org-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/org/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "admin-system-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/system/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "admin-me-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/me/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/v1/audit/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "file-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/api/v1/files/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/v1/customer/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      },
      "customergroup-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/v1/customergroup/{**catch-all}"
        },
        "AuthorizationPolicy": "Secure"
      }
    },
    "Clusters": {
      "invoice-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://invoice-api:8080"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://customer-api:8080"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://payment-api:8080"
          }
        }
      },
      "report-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://report-api:8080"
          }
        }
      },
      "orchestration-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://orchestration-api:8080"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://admin-api:8080"
          }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://audit-api:8080"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://file-api:8080"
          }
        }
      }
    }
  }
}