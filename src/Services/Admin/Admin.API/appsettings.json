{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=AdminDb;User Id=sa;Password=Password123!;TrustServerCertificate=True"
  },
  "Jwt": {
    "SecretKey": "BizcoreERPSecretKeyMustBeVeryLongAndSecure!!!",
    "Issuer": "bizcore-admin",
    "Audience": "bizcore-erp",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Loki": {
    "Url": "http://loki:3100"
  }
}